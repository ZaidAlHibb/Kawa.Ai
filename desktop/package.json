{
  "name": "pintar-desktop",
  "version": "1.0.0",
  "description": "Versi desktop (.exe) dari Kawa.Ai",
  "main": "main.js",
  "scripts": {
    "prestart": "node copy-server.js",
    "start": "electron .",
    "predist": "node copy-server.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.pintar.desktop",
    "productName": "Kawa.Ai",
    "files": ["main.js", "server/**/*"],
    "win": { "target": "portable" }
  }
}
